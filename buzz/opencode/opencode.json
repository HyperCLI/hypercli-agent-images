{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "hypercli": {
      "npm": "@ai-sdk/anthropic",
      "name": "HyperCLI",
      "options": {
        "baseURL": "{env:HYPER_API_BASE}/v1",
        "apiKey": "{env:HYPER_AGENTS_API_KEY}"
      },
      "models": {
        "default": {
          "name": "default",
          "limit": {
            "context": 262144,
            "output": 65536
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "default-anthropic": {
          "name": "default-anthropic",
          "limit": {
            "context": 262144,
            "output": 65536
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "coding": {
          "name": "coding",
          "limit": {
            "context": 262144,
            "output": 65536
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "coding-anthropic": {
          "name": "coding-anthropic",
          "limit": {
            "context": 262144,
            "output": 65536
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "kimi-k3": {
          "name": "kimi-k3",
          "limit": {
            "context": 262144,
            "output": 65536
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "kimi-k3-anthropic": {
          "name": "kimi-k3-anthropic",
          "limit": {
            "context": 262144,
